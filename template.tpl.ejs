    mockData.type = 'init';
    mockData.convivaCustomerKey = 'test_key';
    mockData.appId = 'Test App';
    mockData.scriptSource = 'conviva_hosted';
    mockData.scriptVersionCustom = '2.0.1';

    var injectedUrl;
    mock('injectScript', function(url, success, failure, id) {
      injectedUrl = url;
      success();
    });
    mock('copyFromWindow', function(key) {
      return function() {};
    });

    runCode(mockData);
    assertThat(injectedUrl).isEqualTo('https://sensor.conviva.com/dpi/releases/2.0.1/convivaAppTracker.js');
    assertApi('gtmOnSuccess').wasCalled();
